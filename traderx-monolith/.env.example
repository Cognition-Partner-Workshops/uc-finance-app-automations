# TraderX backend environment variables
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Sentry DSN for error monitoring. When set, the backend initializes the Sentry
# SDK and reports uncaught 500s (see app/main.py). Leave empty to disable Sentry.
# Find it in Sentry under: Settings -> Projects -> <your project> -> Client Keys (DSN).
SENTRY_DSN=
